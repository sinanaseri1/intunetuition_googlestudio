# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URLS: Comma-separated list of every origin this deployment serves.
# Used for CORS and to build Stripe success/cancel URLs — a checkout started on
# one domain returns to that same domain. The first entry is the default when a
# request's origin isn't recognised. No trailing slashes.
APP_URLS="https://intunetuition.co.uk,https://intunetuition-googlestudio.vercel.app"

# APP_URL: Single-origin fallback, still honoured when APP_URLS is unset.
# Set APP_URLS instead if the app is reachable on more than one domain.
APP_URL="http://localhost:3000"

# STRIPE_SECRET_KEY: Required. The ONLY Stripe key this app needs.
# Checkout is server-driven (hosted Stripe Checkout): the server creates the
# session and the browser is redirected to Stripe's own page, so there is no
# client-side Stripe SDK and NO PUBLISHABLE KEY IS REQUIRED. Do not add
# VITE_STRIPE_PUBLISHABLE_KEY (or NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, which is a
# Next.js convention and irrelevant here) — nothing reads them. See README.md.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRETS: Comma-separated signing secrets. Register one Stripe
# webhook endpoint per domain and list both secrets here; each incoming event is
# verified against them in turn.
STRIPE_WEBHOOK_SECRETS="whsec_...,whsec_..."

# STRIPE_WEBHOOK_SECRET: Single-endpoint fallback, used when STRIPE_WEBHOOK_SECRETS is unset.
STRIPE_WEBHOOK_SECRET="whsec_..."

# FIREBASE_SERVICE_ACCOUNT: Required for server-side Firebase Admin SDK operations
# (Stripe webhook credit updates, account anonymization, data export endpoints).
# Paste the entire service account JSON from Firebase Console > Project Settings > Service Accounts.
# Use PowerShell to convert newlines: $json = Get-Content -Raw service-account.json; $json -replace "`n", "\n"
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"YOUR_PROJECT_ID"}'

# Admin access is role-based (users/{uid}.role == 'admin' in Firestore), not
# tied to an env var or hardcoded email. See "Bootstrap the first admin" in
# DEPLOYMENT.md for how to grant the first admin after signing up.

# Firebase Configuration
# These are optional in AI Studio (which uses firebase-applet-config.json)
# but required if you clone the repo and want to use environment variables.
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
VITE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
